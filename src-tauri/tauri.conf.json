{
  "build": {
    "beforeDevCommand": "yarn --cwd ../ui dev",
    "beforeBuildCommand": "yarn --cwd ../ui build",
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/rubic.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [
      "../ui/dist/**/*"
    ],
    "shortDescription": "",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "Rubic",
  "mainBinaryName": "Rubic",
  "version": "1.2.0",
  "identifier": "com.rubic.dev",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "title": "Rubic",
        "visible": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset:",
        "connect-src": "'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* ipc: http://ipc.localhost https://api.coingecko.com",
        "script-src": "'self' 'unsafe-inline'",
        "default-src": "'self'"
      }
    }
  }
}